{
  "name": "agentic-design-runtime",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter '!@tva-agentic-design/studio' -r --if-present build",
    "build:check": "node scripts/check-build-output.mjs",
    "clean": "pnpm -r --if-present clean",
    "dev": "pnpm --filter @tva-agentic-design/runtime dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "plugin:validate": "node scripts/validate-plugin.mjs",
    "plugin:install:personal": "node scripts/install-personal-plugin.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm plugin:validate && pnpm test && pnpm test:visual && pnpm test:performance && pnpm build:check",
    "pack:release": "pnpm build && node scripts/package-release.mjs",
    "pack:release:published": "pnpm build && node scripts/package-release.mjs --packages-from-registry",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "verify:packed": "node scripts/verify-packed-release.mjs",
    "public:snapshot": "node scripts/create-public-snapshot.mjs",
    "public:verify": "node scripts/verify-public-snapshot.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/pixelmatch": "5.2.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "pixelmatch": "7.2.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "ssim.js": "3.5.0",
    "tsup": "8.5.1",
    "tsx": "4.23.7",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
