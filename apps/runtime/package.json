{
  "name": "@agentic-design/runtime",
  "version": "1.0.0",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlobrands/AgenticDesignRuntime.git",
    "directory": "apps/runtime"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "design-runtime": "dist/cli.js"
  },
  "files": [
    "dist",
    "studio",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --platform node --target node22 --clean --out-dir dist && pnpm --filter @agentic-design/studio build && node scripts/copy-studio.mjs",
    "clean": "rimraf dist studio fonts",
    "dev": "tsx src/cli.ts dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "chokidar": "5.0.0",
    "fastify": "5.10.0",
    "file-type": "22.0.1",
    "fontkit": "2.0.4",
    "playwright": "1.61.1",
    "saxes": "6.0.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@agentic-design/core": "workspace:*",
    "@agentic-design/renderer-pixi": "workspace:*"
  }
}
